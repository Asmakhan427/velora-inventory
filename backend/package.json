{
  "name": "deimos-inventory-backend",
  "version": "1.0.0",
  "description": "Product Inventory Management System - REST API",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "seed:if-empty": "node src/db/seedIfEmpty.js",
    "setup": "npm run migrate && npm run seed",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testPathIgnorePatterns": ["/node_modules/", "/src/__tests__/setup.js"]
  }
}
